pipeline {
    agent any


    stages {
        stage('Environment Setup') {
            steps {
                sh '''
                    # 1. Dynamically find the Homebrew path
                    BREW_PREFIX=$(brew --prefix libgit2)
                    
                    # 2. Set strict flags for the compiler and linker
                    export LDFLAGS="-L${BREW_PREFIX}/lib"
                    export CPPFLAGS="-I${BREW_PREFIX}/include"
                    export PKG_CONFIG_PATH="${BREW_PREFIX}/lib/pkgconfig"
                    
                    # 3. Explicitly tell pygit2 where libgit2 is during build
                    export LIBGIT2=${BREW_PREFIX}

                    # 4. Clean install to avoid using a corrupted/cached wheel
                    python3 -m pip install --upgrade pip
                    python3 -m pip install --no-cache-dir pygit2
                    
                    # 5. Install the rest
                    python3 -m pip install gitless
                    if [ -f requirements.txt ]; then
                        python3 -m pip install -r requirements.txt
                    fi
                '''
            }
        }

        stage('Run Experiments') {
            parallel {
                stage('Git Experiments') {
                    steps {
                        dir('scripts/git') {
                            script {
                                def scripts = findFiles(glob: '*.sh')
                                scripts.each { file ->
                                    echo "Running Git experiment: ${file.name}"
                                    sh "chmod +x ${file.name} && ./${file.name}"
                                }
                            }
                        }
                    }
                }

                stage('Gitless Experiments') {
                    steps {
                        dir('scripts/gitless') {
                            script {
                                def scripts = findFiles(glob: '*.sh')
                                scripts.each { file ->
                                    echo "Running Gitless experiment: ${file.name}"
                                    sh "chmod +x ${file.name} && ./${file.name}"
                                }
                            }
                        }
                    }
                }
            }
        }
    }

    post {
        always {
            echo 'Archiving experiment results...'
            // This captures any output logs or data generated in your results folder
            archiveArtifacts artifacts: 'results/**/*', allowEmptyArchive: true
        }
    }
}