pipeline {
    agent any

    environment {
        PATH = "/usr/local/bin:${env.PATH}"
    }

    stages {
        stage('Setup Python Environment') {
            steps {
                sh """
                    python3 -m venv venv
                    . venv/bin/activate
                    pip install --upgrade pip
                    pip install -r requirements.txt
                """
            }
        }

        stage('Run Experiments') {
            parallel {
                stage('Git Experiments') {
                    steps {
                        sh '''
                            # Disable 'exit on error' for this block
                            set +e 
                            
                            for script in scripts/git/*.sh; do
                                if [ -f "$script" ]; then
                                    echo "Running: $script"
                                    chmod +x "$script"
                                    ./"$script"
                                    
                                    # We can manually check the status if we want to log it
                                    if [ $? -ne 0 ]; then
                                        echo "Result: $script failed, but the loop continues."
                                    fi
                                fi
                            done
                            
                            # Re-enable if there were subsequent commands you wanted to protect
                            set -e 
                        '''
                    }
                }

                // stage('Gitless Experiments') {
                //     steps {
                //         sh '''
                //             # Only run if the directory exists
                //             if [ -d "scripts/gitless" ]; then
                //                 for script in scripts/gitless/*.sh; do
                //                     if [ -f "$script" ]; then
                //                         echo "------------------------------------------"
                //                         echo "Running Gitless: $script"
                //                         chmod +x "$script"
                                        
                //                         # Ensuring the pipeline doesn't stop on Gitless errors
                //                         ./"$script" || echo "Gitless script $script failed, continuing..."
                //                     fi
                //                 done
                //             fi
                //         '''
                //     }
                // }
            }
        }
    }

    post {
        always {
            // Using archiveArtifacts (which is in your allowed list) 
            // to save results from your experiments
            archiveArtifacts artifacts: 'results/**/*', allowEmptyArchive: true
        }
    }
}