pipeline {
    agent any

    environment {
        PATH = "/usr/local/bin:${env.PATH}"
    }

    stages {
        stage('Setup Python Environment') {
            steps {
                sh """
                    python3 -m venv venv
                    . venv/bin/activate
                    pip install --upgrade pip
                    pip install -r requirements.txt
                """
            }
        }

        stage('Run Experiments') {
            parallel {
                stage('Git Experiments') {
                    steps {
                        // Use standard shell logic instead of findFiles
                        sh '''
                            cd scripts/git
                            for script in *.sh; do
                                if [ -f "$script" ]; then
                                    echo "Running: $script"
                                    chmod +x "$script"
                                    ./"$script"
                                fi
                            done
                        '''
                    }
                }

                // Commented out per your request, but structure is ready
                /*
                stage('Gitless Experiments') {
                    steps {
                        sh '''
                            cd scripts/gitless
                            for script in *.sh; do
                                if [ -f "$script" ]; then
                                    echo "Running Gitless: $script"
                                    chmod +x "$script"
                                    ./"$script"
                                fi
                            done
                        '''
                    }
                }
                */
            }
        }
    }

    post {
        always {
            // Using archiveArtifacts (which is in your allowed list) 
            // to save results from your experiments
            archiveArtifacts artifacts: 'results/**/*', allowEmptyArchive: true
        }
    }
}