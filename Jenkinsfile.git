pipeline {
    agent any

    environment {
        // Ensuring Jenkins finds your Mac's Homebrew and Python paths
        PATH = "/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin:$PATH"
    }

    stages {
        stage('Environment Setup') {
            steps {
                sh '''
                    python3 -m pip install --upgrade pip
                    if [ -f requirements.txt ]; then
                        python3 -m pip install -r requirements.txt
                    fi
                '''
            }
        }

        stage('Run Experiments') {
            parallel {
                stage('Git Experiments') {
                    steps {
                        // Use standard shell logic instead of findFiles
                        sh '''
                            cd scripts/git
                            for script in *.sh; do
                                if [ -f "$script" ]; then
                                    echo "Running: $script"
                                    chmod +x "$script"
                                    ./"$script"
                                fi
                            done
                        '''
                    }
                }

                // Commented out per your request, but structure is ready
                /*
                stage('Gitless Experiments') {
                    steps {
                        sh '''
                            cd scripts/gitless
                            for script in *.sh; do
                                if [ -f "$script" ]; then
                                    echo "Running Gitless: $script"
                                    chmod +x "$script"
                                    ./"$script"
                                fi
                            done
                        '''
                    }
                }
                */
            }
        }
    }

    post {
        always {
            // Using archiveArtifacts (which is in your allowed list) 
            // to save results from your experiments
            archiveArtifacts artifacts: 'results/**/*', allowEmptyArchive: true
        }
    }
}