pipeline {
    agent any

    environment {
        // Ensuring Jenkins can find Homebrew and Anaconda binaries
        PATH = "/opt/homebrew/bin:/opt/anaconda3/bin:$PATH"
    }

    stages {
        stage('Environment Setup') {
            steps {
                echo 'Setting up environment using Conda and Pip...'
                sh '''
                    # 1. Update Conda and install C-dependencies/Gitless
                    conda install -y -c conda-forge pygit2 gitless
                    
                    # 2. Install any remaining python dependencies
                    if [ -f requirements.txt ]; then
                        pip install -r requirements.txt
                    fi
                '''
            }
        }

        stage('Run Experiments') {
            parallel {
                stage('Git Experiments') {
                    steps {
                        dir('scripts/git') {
                            script {
                                def scripts = findFiles(glob: '*.sh')
                                scripts.each { file ->
                                    echo "Executing: ${file.name}"
                                    sh "chmod +x ${file.name} && ./${file.name}"
                                }
                            }
                        }
                    }
                }

                stage('Gitless Experiments') {
                    steps {
                        dir('scripts/gitless') {
                            script {
                                def scripts = findFiles(glob: '*.sh')
                                scripts.each { file ->
                                    echo "Executing Gitless: ${file.name}"
                                    sh "chmod +x ${file.name} && ./${file.name}"
                                }
                            }
                        }
                    }
                }
            }
        }
    }

    post {
        always {
            echo 'Archiving experiment results...'
            archiveArtifacts artifacts: 'results/**/*', allowEmptyArchive: true
        }
    }
}